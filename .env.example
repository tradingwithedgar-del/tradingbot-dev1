# Copy to .env and fill in. Never commit .env.
TL_ENVIRONMENT=https://demo.tradelocker.com
TL_EMAIL=you@example.com
TL_PASSWORD=change-me
# The server name shown on the TradeLocker login screen
TL_SERVER=
# Optional: leave empty if you have one account. Otherwise the account ID shown in TradeLocker
TL_ACC_NUM=

# demo | live. Live also needs ALLOW_LIVE_TRADING=YES (see README).
BOT_MODE=demo
ALLOW_LIVE_TRADING=NO

# US indices, gold, NVIDIA, Apple, Tesla, WTI oil, crypto (PlexyTrade names - see SYMBOLS.md).
# Names must match TradeLocker exactly - check with: python -m tiim symbols
BOT_SYMBOLS=US30,US500,USTECH,XAUUSD,NVDA,AAPL,TSLA,XTIUSD,BTCUSD,ETHUSD,SOLUSD
BOT_TIMEFRAME=15m

# --- News -------------------------------------------------------------------
# NEWS_ENABLED=1 turns on the economic calendar, earnings dates and breaking headlines.
NEWS_ENABLED=1
# Let Claude read headlines and judge which symbols they move. Pick ONE of:
#  a) your Claude Pro/Max subscription: install Claude Code, run `claude setup-token`, paste the token here
CLAUDE_CODE_OAUTH_TOKEN=
#  b) a Claude API key from https://console.anthropic.com (paid per use)
ANTHROPIC_API_KEY=
# Without either, a simple keyword reader is used (headlines are then context only).
# How often (seconds) TIIM asks Claude Code to read the latest batch of headlines (saves plan usage)
NEWS_CLI_INTERVAL_SECONDS=300

# Dashboard login when TIIM runs on a server (any user name + this password). Empty = no login.
DASHBOARD_PASSWORD=
# Optional: free key from https://finnhub.io for automatic NVDA/AAPL/TSLA earnings dates.
# Without it, put dates in data/earnings.json, e.g. {"NVDA": ["2026-11-19 amc"]}
FINNHUB_API_KEY=
