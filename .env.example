# Copy to .env and fill in. Never commit .env.
TL_ENVIRONMENT=https://demo.tradelocker.com
TL_EMAIL=you@example.com
TL_PASSWORD=change-me
TL_SERVER=PLEXYTRADE-DEMO
# Optional: pick a specific account number if you have several
TL_ACC_NUM=

# demo | live. Live also needs ALLOW_LIVE_TRADING=YES (see README).
BOT_MODE=demo
ALLOW_LIVE_TRADING=NO

BOT_SYMBOLS=EURUSD,GBPUSD,XAUUSD
BOT_TIMEFRAME=15m
