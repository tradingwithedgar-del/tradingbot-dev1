# Copy to .env and fill in. Never commit .env.
TL_ENVIRONMENT=https://demo.tradelocker.com
TL_EMAIL=you@example.com
TL_PASSWORD=change-me
# The server name shown on the TradeLocker login screen
TL_SERVER=
# Optional: pick a specific account number if you have several
TL_ACC_NUM=

# demo | live. Live also needs ALLOW_LIVE_TRADING=YES (see README).
BOT_MODE=demo
ALLOW_LIVE_TRADING=NO

# US indices, gold, NVIDIA, Apple, Tesla, US oil.
# Names must match TradeLocker exactly - check with: python -m tradingbot symbols
BOT_SYMBOLS=US30,US500,NAS100,XAUUSD,NVDA,AAPL,TSLA,USOIL
BOT_TIMEFRAME=15m
